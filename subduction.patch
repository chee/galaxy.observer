+/// Read the file a request path names under `dir`, with its content type.
+/// `/` is `index.html`. `None` for a path that is missing, not a regular
+/// file, or that would step outside `dir`.
+async fn read_static_file(
+    dir: &std::path::Path,
+    request_path: &str,
+) -> Option<(&'static str, hyper::body::Bytes)> {
+    let relative = request_path.trim_start_matches('/');
+    let relative = if relative.is_empty() {
+        "index.html"
+    } else {
+        relative
+    };
+    // Only plain names: no `..`, no absolute or empty segments, no dotfiles.
+    if relative
+        .split('/')
+        .any(|part| part.is_empty() || part.starts_with('.') || part.contains('\\'))
+    {
+        return None;
+    }
+
+    let path = dir.join(relative);
+    if !tokio::fs::metadata(&path).await.ok()?.is_file() {
+        return None;
+    }
+    let content_type = match path.extension().and_then(|e| e.to_str()) {
+        Some("html") => "text/html; charset=utf-8",
+        Some("css") => "text/css; charset=utf-8",
+        Some("js") => "text/javascript; charset=utf-8",
+        Some("json") => "application/json",
+        Some("txt") => "text/plain; charset=utf-8",
+        Some("svg") => "image/svg+xml",
+        Some("png") => "image/png",
+        Some("jpg" | "jpeg") => "image/jpeg",
+        Some("ico") => "image/x-icon",
+        Some("woff2") => "font/woff2",
+        _ => "application/octet-stream",
+    };
+    let bytes = tokio::fs::read(&path).await.ok()?;
+    Some((content_type, bytes.into()))
+}
