+//! The server's storage backends, chosen at startup.
+//!
+//! [`CliStorage`] is either the local [`RedbStorage`] (the default) or an
+//! [`ObjectStorage`] bucket (`--object-store`), and [`CliKeyhiveStorage`]
+//! follows it: files under the data directory, or the same bucket. One
+//! concrete type each keeps the handler and `Subduction` type aliases free of
+//! storage parameters.
+
+use future_form::{FutureForm, Sendable};
+use sedimentree_core::{
+    collections::Set,
+    fragment::Fragment,
+    id::SedimentreeId,
+    loose_commit::{LooseCommit, id::CommitId},
+};
+use subduction_core::storage::traits::Storage;
+use subduction_crypto::verified_meta::VerifiedMeta;
+use subduction_keyhive::storage::{KeyhiveStorage, StorageHash};
+use subduction_object_storage::{ObjectKeyhiveStorage, ObjectStorage, ObjectStorageError};
+use subduction_redb_storage::{RedbStorage, RedbStorageError};
+
+use crate::keyhive::{FsKeyhiveStorage, FsKeyhiveStorageError};
+
+/// The storage backend the server runs on.
+#[derive(Debug, Clone)]
+pub(crate) enum CliStorage {
+    /// redb + blob files under the data directory.
+    Redb(RedbStorage),
+
+    /// An object store bucket.
+    Object(ObjectStorage),
+}
+
+/// Error from whichever backend [`CliStorage`] holds.
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum CliStorageError {
+    #[error(transparent)]
+    Redb(#[from] RedbStorageError),
+
+    #[error(transparent)]
+    Object(#[from] ObjectStorageError),
+}
+
+type Future<'a, T> = <Sendable as FutureForm>::Future<'a, Result<T, CliStorageError>>;
+
+/// Forward a [`Storage`] method to the held backend.
+macro_rules! forward {
+    ($self:ident.$method:ident($($arg:ident),*)) => {
+        Sendable::from_future(async move {
+            match $self {
+                Self::Redb(s) => Ok(Storage::<Sendable>::$method(s, $($arg),*).await?),
+                Self::Object(s) => Ok(Storage::<Sendable>::$method(s, $($arg),*).await?),
+            }
+        })
+    };
+}
+
+impl Storage<Sendable> for CliStorage {
+    type Error = CliStorageError;
+
+    fn save_sedimentree_id(&self, id: SedimentreeId) -> Future<'_, ()> {
+        forward!(self.save_sedimentree_id(id))
+    }
+
+    fn delete_sedimentree_id(&self, id: SedimentreeId) -> Future<'_, ()> {
+        forward!(self.delete_sedimentree_id(id))
+    }
+
+    fn load_all_sedimentree_ids(&self) -> Future<'_, Set<SedimentreeId>> {
+        forward!(self.load_all_sedimentree_ids())
+    }
+
+    fn contains_sedimentree_id(&self, id: SedimentreeId) -> Future<'_, bool> {
+        forward!(self.contains_sedimentree_id(id))
+    }
+
+    fn save_loose_commit(
+        &self,
+        id: SedimentreeId,
+        verified: VerifiedMeta<LooseCommit>,
+    ) -> Future<'_, ()> {
+        forward!(self.save_loose_commit(id, verified))
+    }
+
+    fn list_commit_ids(&self, id: SedimentreeId) -> Future<'_, Set<CommitId>> {
+        forward!(self.list_commit_ids(id))
+    }
+
+    fn load_loose_commits(&self, id: SedimentreeId) -> Future<'_, Vec<VerifiedMeta<LooseCommit>>> {
+        forward!(self.load_loose_commits(id))
+    }
+
+    fn load_loose_commit_metas(&self, id: SedimentreeId) -> Future<'_, Vec<LooseCommit>> {
+        forward!(self.load_loose_commit_metas(id))
+    }
+
+    fn load_loose_commit(
+        &self,
+        id: SedimentreeId,
+        commit_id: CommitId,
+    ) -> Future<'_, Option<VerifiedMeta<LooseCommit>>> {
+        forward!(self.load_loose_commit(id, commit_id))
+    }
+
+    fn delete_loose_commit(&self, id: SedimentreeId, commit_id: CommitId) -> Future<'_, ()> {
+        forward!(self.delete_loose_commit(id, commit_id))
+    }
+
+    fn delete_loose_commits(&self, id: SedimentreeId) -> Future<'_, ()> {
+        forward!(self.delete_loose_commits(id))
+    }
+
+    fn save_fragment(&self, id: SedimentreeId, verified: VerifiedMeta<Fragment>) -> Future<'_, ()> {
+        forward!(self.save_fragment(id, verified))
+    }
+
+    fn load_fragment(
+        &self,
+        id: SedimentreeId,
+        fragment_head: CommitId,
+    ) -> Future<'_, Option<VerifiedMeta<Fragment>>> {
+        forward!(self.load_fragment(id, fragment_head))
+    }
+
+    fn list_fragment_ids(&self, id: SedimentreeId) -> Future<'_, Set<CommitId>> {
+        forward!(self.list_fragment_ids(id))
+    }
+
+    fn load_fragments(&self, id: SedimentreeId) -> Future<'_, Vec<VerifiedMeta<Fragment>>> {
+        forward!(self.load_fragments(id))
+    }
+
+    fn load_fragment_metas(&self, id: SedimentreeId) -> Future<'_, Vec<Fragment>> {
+        forward!(self.load_fragment_metas(id))
+    }
+
+    fn delete_fragment(&self, id: SedimentreeId, fragment_head: CommitId) -> Future<'_, ()> {
+        forward!(self.delete_fragment(id, fragment_head))
+    }
+
+    fn delete_fragments(&self, id: SedimentreeId) -> Future<'_, ()> {
+        forward!(self.delete_fragments(id))
+    }
+
+    fn save_batch(
+        &self,
+        id: SedimentreeId,
+        commits: Vec<VerifiedMeta<LooseCommit>>,
+        fragments: Vec<VerifiedMeta<Fragment>>,
+    ) -> Future<'_, usize> {
+        forward!(self.save_batch(id, commits, fragments))
+    }
+}
+
+/// Where the server keeps its keyhive state.
+#[derive(Debug, Clone)]
+pub(crate) enum CliKeyhiveStorage {
+    /// Files under the data directory.
+    Fs(FsKeyhiveStorage),
+
+    /// The object store bucket the sedimentree data is in.
+    Object(ObjectKeyhiveStorage),
+}
+
+/// Error from whichever backend [`CliKeyhiveStorage`] holds.
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum CliKeyhiveStorageError {
+    #[error(transparent)]
+    Fs(#[from] FsKeyhiveStorageError),
+
+    #[error(transparent)]
+    Object(#[from] ObjectStorageError),
+}
+
+type KeyhiveFuture<'a, T> = <Sendable as FutureForm>::Future<'a, Result<T, CliKeyhiveStorageError>>;
+
+/// Forward a [`KeyhiveStorage`] method to the held backend.
+macro_rules! forward_keyhive {
+    ($self:ident.$method:ident($($arg:ident),*)) => {
+        Sendable::from_future(async move {
+            match $self {
+                Self::Fs(s) => Ok(KeyhiveStorage::<Sendable>::$method(s, $($arg),*).await?),
+                Self::Object(s) => Ok(KeyhiveStorage::<Sendable>::$method(s, $($arg),*).await?),
+            }
+        })
+    };
+}
+
+impl KeyhiveStorage<Sendable> for CliKeyhiveStorage {
+    type Error = CliKeyhiveStorageError;
+
+    fn save_archive(&self, hash: StorageHash, data: Vec<u8>) -> KeyhiveFuture<'_, ()> {
+        forward_keyhive!(self.save_archive(hash, data))
+    }
+
+    fn load_archives(&self) -> KeyhiveFuture<'_, Vec<(StorageHash, Vec<u8>)>> {
+        forward_keyhive!(self.load_archives())
+    }
+
+    fn delete_archive(&self, hash: StorageHash) -> KeyhiveFuture<'_, ()> {
+        forward_keyhive!(self.delete_archive(hash))
+    }
+
+    fn save_event(&self, hash: StorageHash, data: Vec<u8>) -> KeyhiveFuture<'_, ()> {
+        forward_keyhive!(self.save_event(hash, data))
+    }
+
+    fn load_events(&self) -> KeyhiveFuture<'_, Vec<(StorageHash, Vec<u8>)>> {
+        forward_keyhive!(self.load_events())
+    }
+
+    fn delete_event(&self, hash: StorageHash) -> KeyhiveFuture<'_, ()> {
+        forward_keyhive!(self.delete_event(hash))
+    }
+}
