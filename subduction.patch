+/// Iroh's relay probes: `/ping` (latency) is an empty 200, and
+/// `/generate_204` (captive portal check) a 204 that echoes a well-formed
+/// `X-Iroh-Challenge` as `X-Iroh-Response: response <challenge>`.
+fn iroh_relay_probe<B>(
+    req: &hyper::Request<B>,
+) -> Option<hyper::Response<http_body_util::Full<hyper::body::Bytes>>> {
+    use hyper::{
+        Response, StatusCode,
+        header::{ACCESS_CONTROL_ALLOW_ORIGIN, CONNECTION, HeaderValue},
+    };
+
+    let mut resp = Response::new(http_body_util::Full::default());
+    if req.uri().path() == iroh_relay::http::RELAY_PROBE_PATH {
+        *resp.status_mut() = StatusCode::OK;
+        resp.headers_mut()
+            .insert(ACCESS_CONTROL_ALLOW_ORIGIN, HeaderValue::from_static("*"));
+    } else if req.uri().path() == "/generate_204" {
+        *resp.status_mut() = StatusCode::NO_CONTENT;
+        let challenge = req
+            .headers()
+            .get("x-iroh-challenge")
+            .and_then(|c| c.to_str().ok())
+            .filter(|c| {
+                !c.is_empty()
+                    && c.len() < 64
+                    && c.bytes()
+                        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_'))
+            });
+        if let Some(value) =
+            challenge.and_then(|c| HeaderValue::try_from(format!("response {c}")).ok())
+        {
+            resp.headers_mut().insert("x-iroh-response", value);
+        }
+    } else {
+        return None;
+    }
+    resp.headers_mut()
+        .insert(CONNECTION, HeaderValue::from_static("close"));
+    Some(resp)
+}
