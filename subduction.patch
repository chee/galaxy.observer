+/// How much of a request the accept loop looks at to route it.
+const PEEK_BYTES: usize = 8 * 1024;
+
+/// How long the accept loop waits for a `GET` request's headers to arrive.
+const PEEK_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// Peek at the start of a connection without consuming it.
+///
+/// A `GET` is either a WebSocket upgrade or a plain HTTP request, and only
+/// its headers say which, so for a `GET` this waits until the whole request
+/// head has arrived (or [`PEEK_BYTES`] / [`PEEK_TIMEOUT`] is reached).
+/// `None` when the peer sent fewer than three bytes.
+async fn peek_request_head(tcp: &tokio::net::TcpStream) -> Option<Vec<u8>> {
+    let mut buf = vec![0u8; PEEK_BYTES];
+    let deadline = Instant::now() + PEEK_TIMEOUT;
+    loop {
+        let n = tcp.peek(&mut buf).await.ok()?;
+        if n < 3 {
+            return None;
+        }
+        let head = buf.get(..n)?;
+        let complete = !head.starts_with(b"GET")
+            || n == PEEK_BYTES
+            || head.windows(4).any(|w| w == b"\r\n\r\n");
+        if complete || Instant::now() >= deadline {
+            buf.truncate(n);
+            return Some(buf);
+        }
+        // `peek` returns at once while unread bytes are buffered.
+        time::sleep(Duration::from_millis(5)).await;
+    }
