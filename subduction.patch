+/// Answer plain HTTP `GET` requests: the server's keyhive contact card at
+/// [`CONTACT_CARD_PATH`] and its [aliases](CONTACT_CARD_ALIASES) (the JSON a client hands to keyhive to delegate to
+/// this server; absent when keyhive is disabled), then files from
+/// `--static-dir`. Anything else is a 404.
+async fn handle_http_get(
+    tcp: tokio::net::TcpStream,
+    addr: SocketAddr,
+    contact_card_json: Option<Arc<str>>,
+    static_dir: Option<Arc<std::path::Path>>,
+) {
+    use http_body_util::Full;
+    use hyper::{
+        Request, Response, StatusCode,
+        body::{Bytes, Incoming},
+        header::{
+            ACCESS_CONTROL_ALLOW_ORIGIN, CACHE_CONTROL, CONNECTION, CONTENT_TYPE, HeaderValue,
+        },
+    };
+
+    let service = hyper::service::service_fn(move |req: Request<Incoming>| {
+        let card = contact_card_json.clone();
+        let static_dir = static_dir.clone();
+        async move {
+            let path = req.uri().path();
+            let found = if path == CONTACT_CARD_PATH || CONTACT_CARD_ALIASES.contains(&path) {
+                card.map(|json| ("application/json", Bytes::copy_from_slice(json.as_bytes())))
+            } else if let Some(dir) = static_dir {
+                read_static_file(&dir, path).await
+            } else {
+                None
+            };
+
+            let (status, content_type, body) = match found {
+                Some((content_type, body)) => (StatusCode::OK, content_type, body),
+                None => (
+                    StatusCode::NOT_FOUND,
+                    "text/plain",
+                    Bytes::from_static(b"not found"),
+                ),
+            };
+
+            let mut resp = Response::new(Full::new(body));
+            *resp.status_mut() = status;
+            let headers = resp.headers_mut();
+            headers.insert(CONTENT_TYPE, HeaderValue::from_static(content_type));
+            headers.insert(ACCESS_CONTROL_ALLOW_ORIGIN, HeaderValue::from_static("*"));
+            headers.insert(CACHE_CONTROL, HeaderValue::from_static("no-cache"));
+            headers.insert(CONNECTION, HeaderValue::from_static("close"));
+            Ok::<_, hyper::Error>(resp)
+        }
+    });
+
+    // One request per connection: routing to WebSocket, long-poll or this
+    // handler happens per connection, so a kept-alive connection would answer
+    // a client's later WebSocket upgrade as a page request (Node's `fetch` and
+    // `WebSocket` share a connection pool).
+    let mut builder =
+        hyper_util::server::conn::auto::Builder::new(hyper_util::rt::TokioExecutor::new());
+    builder.http1().keep_alive(false);
+    let conn = builder.serve_connection(hyper_util::rt::TokioIo::new(tcp), service);
+
+    if let Err(e) = conn.await {
+        tracing::debug!(addr = %addr, error = %e, "HTTP connection ended");
+    }
+}
+
+/// Read the file a request path names under `dir`, with its content type.
+/// `/` is `index.html`. `None` for a path that is missing, not a regular
+/// file, or that would step outside `dir`.
+async fn read_static_file(
+    dir: &std::path::Path,
+    request_path: &str,
+) -> Option<(&'static str, hyper::body::Bytes)> {
+    let relative = request_path.trim_start_matches('/');
+    let relative = if relative.is_empty() {
+        "index.html"
+    } else {
+        relative
+    };
+    // Only plain names: no `..`, no absolute or empty segments, no dotfiles.
+    if relative
+        .split('/')
+        .any(|part| part.is_empty() || part.starts_with('.') || part.contains('\\'))
+    {
+        return None;
+    }
+
+    let path = dir.join(relative);
+    if !tokio::fs::metadata(&path).await.ok()?.is_file() {
+        return None;
+    }
+    let content_type = match path.extension().and_then(|e| e.to_str()) {
+        Some("html") => "text/html; charset=utf-8",
+        Some("css") => "text/css; charset=utf-8",
+        Some("js") => "text/javascript; charset=utf-8",
+        Some("json") => "application/json",
+        Some("txt") => "text/plain; charset=utf-8",
+        Some("svg") => "image/svg+xml",
+        Some("png") => "image/png",
+        Some("jpg" | "jpeg") => "image/jpeg",
+        Some("ico") => "image/x-icon",
+        Some("woff2") => "font/woff2",
+        _ => "application/octet-stream",
+    };
+    let bytes = tokio::fs::read(&path).await.ok()?;
+    Some((content_type, bytes.into()))
+}
