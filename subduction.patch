+/// How long a client's request for a document waits on the pull peers.
+const PULL_FIRST_TIMEOUT_MS: u64 = 5_000;
+
+/// The [`PullFirst`] hook for `--ws-pull-peer`: before answering a request
+/// for a document, sync it with each connected pull peer, so a document only
+/// they hold is in the first answer rather than pushed after it. Skipped for
+/// a document we already subscribe to through that peer, which live pushes
+/// keep current, and for a requester that may not fetch it anyway.
+fn pull_before_answering<H: CliWireHandler>(
+    subduction: std::sync::Weak<<CliSubduction<H> as std::ops::Deref>::Target>,
+    policy: Arc<CliKeyhivePolicyHandle>,
+) -> Box<PullFirstFn> {
+    Box::new(move |from, id| {
+        let subduction = subduction.clone();
+        let policy = Arc::clone(&policy);
+        Box::pin(async move {
+            let Some(subduction) = subduction.upgrade() else {
+                return;
+            };
+            if policy.is_pull_only(&from) || policy.authorize_fetch(from, id).await.is_err() {
+                return;
+            }
+            for peer in subduction.connected_peer_ids().await {
+                if !policy.is_pull_only(&peer)
+                    || subduction.get_peer_subscriptions(peer).await.contains(&id)
+                {
+                    continue;
+                }
+                let started = Instant::now();
+                match subduction
+                    .sync_with_peer(
+                        &peer,
+                        id,
+                        true,
+                        CallTimeout::TimeoutMillis(PULL_FIRST_TIMEOUT_MS),
+                    )
+                    .await
+                {
+                    Ok((ok, stats, _)) => tracing::info!(
+                        peer = %peer,
+                        tree = ?id,
+                        ok,
+                        commits_received = stats.commits_received,
+                        fragments_received = stats.fragments_received,
+                        elapsed_ms = started.elapsed().as_millis(),
+                        "Pulled document before answering"
+                    ),
+                    Err(e) => tracing::warn!(
+                        peer = %peer,
+                        tree = ?id,
+                        error = %e,
+                        "Pull before answering failed"
+                    ),
+                }
+            }
+        })
+    })
+}
+
+/// Keep a connection to a `--ws-pull-peer` for as long as the server runs.
+/// Each time it connects, sync every document we hold with it (subscribing,
+/// so later changes are pushed to us), since subscriptions passed on for
+/// clients do not survive a reconnect; when it drops, connect again, backing
+/// off up to five minutes between failures.
+#[allow(clippy::too_many_arguments)]
+async fn pull_from_ws_peer<H: CliWireHandler>(
+    uri: Uri,
+    service_name: String,
+    subduction: CliSubduction<H>,
+    ephemeral: CliEphemeralHandler,
+    keyhive: Option<CliKeyhiveProtocol>,
+    signer: MemorySigner,
+    policy: Arc<CliKeyhivePolicyHandle>,
+    cancel: CancellationToken,
+    max_message_size: usize,
+    max_frame_size: usize,
+) {
+    const MAX_BACKOFF: Duration = Duration::from_secs(300);
+    let mut backoff = Duration::from_secs(1);
+    while !cancel.is_cancelled() {
+        match try_connect_ws(
+            uri.clone(),
+            &subduction,
+            &ephemeral,
+            keyhive.as_ref(),
+            &signer,
+            &service_name,
+            cancel.clone(),
+            max_message_size,
+            max_frame_size,
+            KeepAlive::balanced(),
+            Some(&policy),
+        )
+        .await
+        {
+            Ok(remote_id) => {
+                backoff = Duration::from_secs(1);
+                let started = Instant::now();
+                let (_, stats, conn_errs, doc_errs) = subduction
+                    .full_sync_with_peer(&remote_id, true, CallTimeout::Default)
+                    .await;
+                tracing::info!(
+                    uri = %uri,
+                    peer = %remote_id,
+                    commits_received = stats.commits_received,
+                    fragments_received = stats.fragments_received,
+                    commits_sent = stats.commits_sent,
+                    fragments_sent = stats.fragments_sent,
+                    connection_errors = conn_errs.len(),
+                    document_errors = doc_errs.len(),
+                    elapsed_ms = started.elapsed().as_millis(),
+                    "Pulled from peer"
+                );
+                // Stay idle while the connection lasts.
+                let mut tick = time::interval(Duration::from_secs(10));
+                loop {
+                    tokio::select! {
+                        () = cancel.cancelled() => return,
+                        _ = tick.tick() => {}
+                    }
+                    if !subduction.connected_peer_ids().await.contains(&remote_id) {
+                        tracing::warn!(uri = %uri, peer = %remote_id, "Pull peer disconnected");
+                        break;
+                    }
+                }
+            }
+            Err(e) => {
+                tracing::error!(uri = %uri, error = %e, retry_in = ?backoff, "Failed to connect to pull peer");
+                tokio::select! {
+                    () = cancel.cancelled() => return,
+                    () = time::sleep(backoff) => {}
+                }
+                backoff = (backoff * 2).min(MAX_BACKOFF);
+            }
+        }
+    }
+}
