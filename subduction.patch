+        let (Some(name), Some(value)) = (parts.next(), parts.next()) else {
+            return false;
+        };
+        name.trim_ascii().eq_ignore_ascii_case(b"upgrade")
+            && value.trim_ascii().eq_ignore_ascii_case(b"websocket")
+    })
+}
