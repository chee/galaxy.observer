+//! Plain HTTP on the sync port: the keyhive contact card at
+//! `/.well-known/keyhive/contact-card.json` and files from `--static-dir`,
+//! beside the sync transports.
+
+#![allow(
+    clippy::expect_used,
+    clippy::panic,
+    clippy::unwrap_used,
+    missing_docs,
+    unreachable_pub
+)]
+
+use std::{
+    io::{Read, Write},
+    net::TcpStream,
+    process::{Child, Command, Stdio},
+    time::Duration,
+};
+
+const SERVER_STARTUP_TIMEOUT: Duration = Duration::from_secs(30);
+const CONTACT_CARD_PATH: &str = "/.well-known/keyhive/contact-card.json";
+
+struct Server {
+    child: Child,
+    port: u16,
+    _dir: tempfile::TempDir,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        drop(self.child.kill());
+        drop(self.child.wait());
+    }
+}
+
+impl Server {
+    fn url(&self, path: &str) -> String {
+        format!("http://127.0.0.1:{}{path}", self.port)
+    }
+}
+
+/// Spawn a server on an OS-assigned port and wait for its ready file.
+async fn spawn_server(auth: &str, key_seed: &str, extra: &[&str]) -> Server {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let ready_file = dir.path().join("ready");
+    let child = Command::new(env!("CARGO_BIN_EXE_subduction_cli"))
+        .arg("server")
+        .args(["--socket", "127.0.0.1:0"])
+        .args(["--key-seed", key_seed])
+        .args(["--auth", auth])
+        .arg("--data-dir")
+        .arg(dir.path().join("data"))
+        .arg("--ready-file")
+        .arg(&ready_file)
+        .args(extra)
+        .stderr(Stdio::inherit())
+        .stdout(Stdio::null())
+        .spawn()
+        .expect("failed to spawn server");
+    let mut server = Server {
+        child,
+        port: 0,
+        _dir: dir,
+    };
+
+    let deadline = tokio::time::Instant::now() + SERVER_STARTUP_TIMEOUT;
+    loop {
+        assert!(
+            tokio::time::Instant::now() <= deadline,
+            "timed out waiting for ready file at {}",
+            ready_file.display()
+        );
+        if let Ok(content) = std::fs::read_to_string(&ready_file)
+            && let Some(port) = content.lines().find_map(|l| l.strip_prefix("port="))
+        {
+            server.port = port.parse().expect("ready file port should be a u16");
+            return server;
+        }
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
+
+#[tokio::test]
+async fn keyhive_server_publishes_its_contact_card() {
+    let seed = "11".repeat(32);
+    let server = spawn_server("keyhive", &seed, &[]).await;
+
+    let resp = reqwest::get(server.url(CONTACT_CARD_PATH)).await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.headers()["content-type"], "application/json");
+    assert_eq!(resp.headers()["access-control-allow-origin"], "*");
+    let body = resp.text().await.unwrap();
+
+    let card: keyhive_core::contact_card::ContactCard =
+        serde_json::from_str(&body).expect("the body must parse as a keyhive contact card");
+    let again = serde_json::to_string(&card).unwrap();
+    assert_eq!(
+        again, body,
+        "the card round-trips through keyhive's own type"
+    );
+
+    for alias in ["/contact-card.json", "/contact-card"] {
+        let resp = reqwest::get(server.url(alias)).await.unwrap();
+        assert_eq!(resp.status(), 200, "{alias}");
+        assert_eq!(resp.headers()["content-type"], "application/json");
+        assert_eq!(resp.text().await.unwrap(), body, "{alias}");
+    }
+
+    // A query string still reaches the card; a longer path does not.
+    let resp = reqwest::get(server.url(&format!("{CONTACT_CARD_PATH}?x=1")))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    let resp = reqwest::get(server.url(&format!("{CONTACT_CARD_PATH}.bak")))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 404);
+
+    // The same key gives the same identity after a restart.
+    let issuer = |body: &str| -> serde_json::Value {
+        let value: serde_json::Value = serde_json::from_str(body).unwrap();
+        value
+            .as_object()
+            .and_then(|o| o.values().next())
+            .and_then(|op| op.get("issuer"))
+            .cloned()
+            .expect("a contact card names its issuer")
+    };
+    drop(server);
+    let restarted = spawn_server("keyhive", &seed, &[]).await;
+    let body_again = reqwest::get(restarted.url(CONTACT_CARD_PATH))
+        .await
+        .unwrap()
+        .text()
+        .await
+        .unwrap();
+    assert_eq!(issuer(&body_again), issuer(&body));
+}
+
+#[tokio::test]
+async fn open_server_has_no_contact_card() {
+    let server = spawn_server("open", &"22".repeat(32), &[]).await;
+    let resp = reqwest::get(server.url(CONTACT_CARD_PATH)).await.unwrap();
+    assert_eq!(resp.status(), 404);
+}
+
+/// Send raw bytes and read the whole response, for requests an HTTP client
+/// would normalise away.
+fn raw_request(port: u16, request: &str) -> String {
+    let mut tcp = TcpStream::connect(("127.0.0.1", port)).unwrap();
+    tcp.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+    tcp.write_all(request.as_bytes()).unwrap();
+    let mut response = String::new();
+    drop(tcp.read_to_string(&mut response));
+    response
+}
+
+#[tokio::test]
+async fn static_dir_is_served_to_plain_gets() {
+    let site = tempfile::tempdir().unwrap();
+    std::fs::write(site.path().join("index.html"), "<h1>hello starlight</h1>").unwrap();
+    std::fs::write(site.path().join("font.woff2"), [0u8, 1, 2, 3]).unwrap();
+    std::fs::write(site.path().join(".env"), "SECRET=1").unwrap();
+    std::fs::create_dir(site.path().join("sub")).unwrap();
+    let outside = site.path().parent().unwrap().join("outside-static-dir.txt");
+    std::fs::write(&outside, "outside").unwrap();
+
+    let server = spawn_server(
+        "open",
+        &"33".repeat(32),
+        &["--static-dir", site.path().to_str().unwrap()],
+    )
+    .await;
+
+    let resp = reqwest::get(server.url("/")).await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.headers()["content-type"], "text/html; charset=utf-8");
+    assert_eq!(resp.text().await.unwrap(), "<h1>hello starlight</h1>");
+
+    let resp = reqwest::get(server.url("/font.woff2")).await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.headers()["content-type"], "font/woff2");
+    assert_eq!(resp.bytes().await.unwrap().as_ref(), [0u8, 1, 2, 3]);
+
+    for missing in ["/nope.html", "/sub", "/.env"] {
+        let resp = reqwest::get(server.url(missing)).await.unwrap();
+        assert_eq!(resp.status(), 404, "{missing}");
+    }
+
+    // A path that climbs out of the directory is refused.
+    let response = raw_request(
+        server.port,
+        "GET /../outside-static-dir.txt HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
+    );
+    assert!(response.starts_with("HTTP/1.1 404"), "{response}");
+    assert!(!response.contains("outside"));
+    std::fs::remove_file(outside).unwrap();
+
+    // A request head that arrives in pieces is still routed as plain HTTP.
+    let mut tcp = TcpStream::connect(("127.0.0.1", server.port)).unwrap();
+    tcp.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+    tcp.write_all(b"GET / HTTP/1.1\r\nHost: x\r\n").unwrap();
+    tcp.flush().unwrap();
+    std::thread::sleep(Duration::from_millis(200));
+    tcp.write_all(b"Connection: close\r\n\r\n").unwrap();
+    let mut response = String::new();
+    drop(tcp.read_to_string(&mut response));
+    assert!(response.starts_with("HTTP/1.1 200"), "{response}");
+
+    // The contact card path is not a file lookup: keyhive is off here.
+    for path in [CONTACT_CARD_PATH, "/contact-card.json", "/contact-card"] {
+        let resp = reqwest::get(server.url(path)).await.unwrap();
+        assert_eq!(resp.status(), 404, "{path}");
+    }
+}
+
+/// A plain GET does not keep its connection: clients that pool connections
+/// (Node's `fetch` and `WebSocket`) must open a new one for the upgrade.
+#[tokio::test]
+async fn plain_get_closes_its_connection() {
+    let server = spawn_server("keyhive", &"55".repeat(32), &[]).await;
+    let mut tcp = TcpStream::connect(("127.0.0.1", server.port)).unwrap();
+    tcp.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+    tcp.write_all(format!("GET {CONTACT_CARD_PATH} HTTP/1.1\r\nHost: x\r\n\r\n").as_bytes())
+        .unwrap();
+    // read_to_string only returns once the server closes the connection
+    let mut response = String::new();
+    tcp.read_to_string(&mut response).unwrap();
+    assert!(response.starts_with("HTTP/1.1 200"), "{response}");
+    assert!(response.to_ascii_lowercase().contains("connection: close"));
+}
+
+#[tokio::test]
+async fn plain_get_without_static_dir_is_not_found() {
+    let server = spawn_server("open", &"44".repeat(32), &[]).await;
+    let resp = reqwest::get(server.url("/")).await.unwrap();
+    assert_eq!(resp.status(), 404);
+}
diff --git a/subduction_cli/tests/iroh_relay.rs b/subduction_cli/tests/iroh_relay.rs
new file mode 100644
index 0000000..673ede8
--- /dev/null
+++ b/subduction_cli/tests/iroh_relay.rs
@@ -0,0 +1,222 @@
+//! `--serve-iroh-relay`: an iroh relay on the sync port, beside the sync
+//! transports and plain HTTP. Also the server's own iroh endpoint's identity.
+
+#![allow(
+    clippy::expect_used,
+    clippy::panic,
+    clippy::unwrap_used,
+    missing_docs,
+    unreachable_pub
+)]
+
+use std::{
+    io::{Read, Write},
+    net::TcpStream,
+    process::{Child, Command, Stdio},
+    time::Duration,
+};
+
+use futures::{SinkExt, StreamExt};
+use iroh::{RelayUrl, SecretKey, dns::DnsResolver};
+use iroh_relay::{
+    client::{Client, ClientBuilder},
+    protos::relay::{ClientToRelayMsg, Datagrams, RelayToClientMsg},
+    tls::{CaTlsConfig, default_provider},
+};
+
+const SERVER_STARTUP_TIMEOUT: Duration = Duration::from_secs(30);
+
+struct Server {
+    child: Child,
+    port: u16,
+    ready: String,
+    _dir: tempfile::TempDir,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        drop(self.child.kill());
+        drop(self.child.wait());
+    }
+}
+
+impl Server {
+    fn url(&self, path: &str) -> String {
+        format!("http://127.0.0.1:{}{path}", self.port)
+    }
+}
+
+/// Spawn a server on an OS-assigned port and wait for its ready file.
+async fn spawn_server(extra: &[&str]) -> Server {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let ready_file = dir.path().join("ready");
+    let child = Command::new(env!("CARGO_BIN_EXE_subduction_cli"))
+        .arg("server")
+        .args(["--socket", "127.0.0.1:0"])
+        .args(["--key-seed", &"44".repeat(32)])
+        .args(["--auth", "open"])
+        .arg("--data-dir")
+        .arg(dir.path().join("data"))
+        .arg("--ready-file")
+        .arg(&ready_file)
+        .args(extra)
+        .stderr(Stdio::inherit())
+        .stdout(Stdio::null())
+        .spawn()
+        .expect("failed to spawn server");
+    let mut server = Server {
+        child,
+        port: 0,
+        ready: String::new(),
+        _dir: dir,
+    };
+
+    let deadline = tokio::time::Instant::now() + SERVER_STARTUP_TIMEOUT;
+    loop {
+        assert!(
+            tokio::time::Instant::now() <= deadline,
+            "timed out waiting for ready file at {}",
+            ready_file.display()
+        );
+        if let Ok(content) = std::fs::read_to_string(&ready_file)
+            && let Some(port) = content.lines().find_map(|l| l.strip_prefix("port="))
+        {
+            server.port = port.parse().expect("ready file port should be a u16");
+            server.ready = content;
+            return server;
+        }
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
+
+async fn relay_client(server: &Server, secret_key: SecretKey) -> Client {
+    let url: RelayUrl = server.url("").parse().unwrap();
+    let tls = CaTlsConfig::default()
+        .client_config(default_provider())
+        .unwrap();
+    ClientBuilder::new(url, secret_key, DnsResolver::new())
+        .tls_client_config(tls)
+        .connect()
+        .await
+        .expect("connecting to the relay")
+}
+
+/// Send raw bytes and read the whole response.
+fn raw_request(port: u16, request: &str) -> String {
+    let mut tcp = TcpStream::connect(("127.0.0.1", port)).unwrap();
+    tcp.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+    tcp.write_all(request.as_bytes()).unwrap();
+    let mut response = String::new();
+    drop(tcp.read_to_string(&mut response));
+    response
+}
+
+#[tokio::test]
+async fn relays_datagrams_between_clients() {
+    let server = spawn_server(&["--serve-iroh-relay"]).await;
+
+    let a_key = SecretKey::from_bytes(&[1; 32]);
+    let b_key = SecretKey::from_bytes(&[2; 32]);
+    let (a_id, b_id) = (a_key.public(), b_key.public());
+    let mut a = relay_client(&server, a_key).await;
+    let mut b = relay_client(&server, b_key).await;
+
+    // b may not be registered with the relay yet when a first sends.
+    let msg = Datagrams::from("hello, b");
+    let mut received = None;
+    for _ in 0..20 {
+        a.send(ClientToRelayMsg::Datagrams {
+            dst_endpoint_id: b_id,
+            datagrams: msg.clone(),
+        })
+        .await
+        .unwrap();
+        if let Ok(next) = tokio::time::timeout(Duration::from_millis(500), b.next()).await {
+            received = Some(next.expect("relay stream ended").unwrap());
+            break;
+        }
+    }
+    let Some(RelayToClientMsg::Datagrams {
+        remote_endpoint_id,
+        datagrams,
+    }) = received
+    else {
+        panic!("b got {received:?}");
+    };
+    assert_eq!(remote_endpoint_id, a_id);
+    assert_eq!(datagrams, msg);
+}
+
+#[tokio::test]
+async fn answers_relay_probes_beside_the_sync_port() {
+    let site = tempfile::tempdir().unwrap();
+    std::fs::write(site.path().join("index.html"), "home").unwrap();
+    let server = spawn_server(&[
+        "--serve-iroh-relay",
+        "--static-dir",
+        site.path().to_str().unwrap(),
+    ])
+    .await;
+
+    let resp = reqwest::get(server.url("/ping")).await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.headers()["access-control-allow-origin"], "*");
+
+    let response = raw_request(
+        server.port,
+        "GET /generate_204 HTTP/1.1\r\nHost: x\r\nX-Iroh-Challenge: abc.1\r\nConnection: close\r\n\r\n",
+    );
+    assert!(response.starts_with("HTTP/1.1 204"), "{response}");
+    assert!(
+        response
+            .to_ascii_lowercase()
+            .contains("x-iroh-response: response abc.1"),
+        "{response}"
+    );
+
+    // The homepage is still there.
+    let resp = reqwest::get(server.url("/")).await.unwrap();
+    assert_eq!(resp.text().await.unwrap(), "home");
+}
+
+#[tokio::test]
+async fn without_the_flag_there_is_no_relay() {
+    let server = spawn_server(&[]).await;
+    let resp = reqwest::get(server.url("/ping")).await.unwrap();
+    assert_eq!(resp.status(), 404);
+
+    let url: RelayUrl = server.url("").parse().unwrap();
+    let tls = CaTlsConfig::default()
+        .client_config(default_provider())
+        .unwrap();
+    let connected = tokio::time::timeout(
+        Duration::from_secs(10),
+        ClientBuilder::new(url, SecretKey::from_bytes(&[3; 32]), DnsResolver::new())
+            .tls_client_config(tls)
+            .connect(),
+    )
+    .await
+    .expect("a refused relay connection fails promptly");
+    assert!(connected.is_err());
+}
+
+#[tokio::test]
+async fn iroh_endpoint_id_is_the_server_key() {
+    let ready_id = |server: &Server| {
+        server
+            .ready
+            .lines()
+            .find_map(|l| l.strip_prefix("iroh_node_id="))
+            .expect("the ready file names the iroh endpoint")
+            .to_owned()
+    };
+    let expected = SecretKey::from_bytes(&[0x44; 32]).public().to_string();
+
+    let server = spawn_server(&["--iroh", "--iroh-direct-only"]).await;
+    assert_eq!(ready_id(&server), expected);
+    drop(server);
+
+    // The same after a restart, so peers can keep dialing it.
+    let server = spawn_server(&["--iroh", "--iroh-direct-only"]).await;
+    assert_eq!(ready_id(&server), expected);
+}
diff --git a/subduction_cli/tests/pull_peer.rs b/subduction_cli/tests/pull_peer.rs
new file mode 100644
index 0000000..8cd01be
--- /dev/null
+++ b/subduction_cli/tests/pull_peer.rs
@@ -0,0 +1,258 @@
+//! End-to-end test of `--ws-pull-peer`: a server takes a peer's data and
+//! gives none back.
+//!
+//! Server `down` pulls from server `up`. Each holds one commit of the same
+//! document before they meet (a server only syncs documents it knows). After
+//! they connect `down` has both commits and `up` still has only its own; a
+//! commit written to `up` afterwards reaches `down`, and one written to
+//! `down` never reaches `up`. A client subscribing at `down` to a document
+//! only `up` holds gets it, since `down` passes the subscription on.
+
+#![allow(
+    clippy::expect_used,
+    clippy::panic,
+    clippy::unwrap_used,
+    missing_docs,
+    unreachable_pub
+)]
+
+use std::{
+    collections::BTreeSet,
+    path::{Path, PathBuf},
+    process::{Child, Command, Stdio},
+    sync::Arc,
+    time::Duration,
+};
+
+use future_form::Sendable;
+use sedimentree_core::{
+    blob::Blob, depth::CountLeadingZeroBytes, id::SedimentreeId, loose_commit::id::CommitId,
+};
+use subduction_core::{
+    connection::test_utils::TokioSpawn,
+    handler::sync::SyncHandler,
+    policy::open::OpenPolicy,
+    storage::memory::MemoryStorage,
+    subduction::{Subduction, builder::SubductionBuilder},
+    timeout::call::CallTimeout,
+    timestamp::TimestampSeconds,
+    transport::message::MessageTransport,
+};
+use subduction_crypto::signer::memory::MemorySigner;
+use subduction_http_longpoll::{
+    client::HttpLongPollClient, http_client::reqwest_client::ReqwestHttpClient,
+    transport::HttpLongPollTransport,
+};
+use subduction_websocket::timeout::FuturesTimerTimeout;
+
+const SYNC_TIMEOUT: CallTimeout = CallTimeout::TimeoutMillis(10_000);
+// The pull peer greets `up` with its URL's host (less any trailing dot), so
+// that is `up`'s name.
+const UP_NAME: &str = "localhost";
+const DOWN_NAME: &str = "pull-peer-test";
+
+type Client = Arc<
+    Subduction<
+        'static,
+        Sendable,
+        MemoryStorage,
+        MessageTransport<HttpLongPollTransport>,
+        SyncHandler<
+            Sendable,
+            MemoryStorage,
+            MessageTransport<HttpLongPollTransport>,
+            OpenPolicy,
+            CountLeadingZeroBytes,
+            TokioSpawn,
+        >,
+        OpenPolicy,
+        MemorySigner,
+        FuturesTimerTimeout,
+        TokioSpawn,
+        CountLeadingZeroBytes,
+    >,
+>;
+
+struct Server {
+    child: Child,
+    port: u16,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.child.kill().ok();
+        self.child.wait().ok();
+    }
+}
+
+impl Server {
+    fn url(&self) -> String {
+        format!("http://127.0.0.1:{}", self.port)
+    }
+}
+
+fn cli_binary() -> PathBuf {
+    let mut path = std::env::current_exe().expect("test executable path");
+    path.pop();
+    path.pop();
+    path.push("subduction_cli");
+    path
+}
+
+#[allow(clippy::zombie_processes)] // killed and waited on in `Drop`
+async fn spawn_server(key_seed: &str, name: &str, data_dir: &Path, extra: &[&str]) -> Server {
+    let ready = data_dir.join("ready");
+    std::fs::remove_file(&ready).ok();
+    let child = Command::new(cli_binary())
+        .args(["server", "--socket", "127.0.0.1:0", "--auth", "open"])
+        .args(["--key-seed", key_seed, "--service-name", name])
+        .arg("--data-dir")
+        .arg(data_dir)
+        .arg("--ready-file")
+        .arg(&ready)
+        .args(extra)
+        .env("RUST_LOG", "info")
+        .stderr(Stdio::inherit())
+        .stdout(Stdio::null())
+        .spawn()
+        .expect("spawn server");
+    for _ in 0..300 {
+        if let Ok(content) = std::fs::read_to_string(&ready)
+            && let Some(port) = content
+                .lines()
+                .find_map(|l| l.strip_prefix("port="))
+                .and_then(|p| p.parse().ok())
+        {
+            return Server { child, port };
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    panic!("server did not write its ready file");
+}
+
+async fn connect(base_url: &str, seed: u8, name: &str) -> Client {
+    let signer = MemorySigner::from_bytes(&[seed; 32]);
+    let (client, _handler, listener, manager): (Client, _, _, _) = SubductionBuilder::new()
+        .signer(signer.clone())
+        .storage(MemoryStorage::default(), Arc::new(OpenPolicy))
+        .spawner(TokioSpawn)
+        .timer(FuturesTimerTimeout)
+        .build::<Sendable, MessageTransport<HttpLongPollTransport>>();
+    tokio::spawn(listener);
+    tokio::spawn(manager);
+    let lp = HttpLongPollClient::new(base_url, ReqwestHttpClient::new());
+    let result = lp
+        .connect_discover(&signer, name, TimestampSeconds::now())
+        .await
+        .expect("long-poll connect");
+    tokio::spawn(result.poll_task);
+    tokio::spawn(result.send_task);
+    client
+        .add_connection(result.authenticated.map(MessageTransport::new))
+        .await
+        .expect("add_connection");
+    client
+}
+
+async fn write_commit(server: &Server, seed: u8, name: &str, id: SedimentreeId, tag: u8) {
+    let client = connect(&server.url(), seed, name).await;
+    client
+        .add_commit(
+            id,
+            CommitId::new([tag; 32]),
+            BTreeSet::new(),
+            Blob::new(vec![tag]),
+        )
+        .await
+        .expect("add commit");
+    let (ok, _, call_errs, io_errs) = client.full_sync_with_all_peers(SYNC_TIMEOUT).await;
+    assert!(
+        ok && call_errs.is_empty() && io_errs.is_empty(),
+        "write sync failed"
+    );
+    // The commit is sent without an ack: keep the client until it has landed.
+    for read_seed in 0x80..0xb0 {
+        if commits(server, read_seed, name, id).await.contains(&tag) {
+            return;
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    panic!("{name} never stored commit {tag}");
+}
+
+/// The commit tags a fresh client sees on `server` for `id`.
+async fn commits(server: &Server, seed: u8, name: &str, id: SedimentreeId) -> BTreeSet<u8> {
+    let client = connect(&server.url(), seed, name).await;
+    client
+        .sync_with_all_peers(id, false, SYNC_TIMEOUT)
+        .await
+        .expect("read sync");
+    client
+        .get_commits(id)
+        .await
+        .unwrap_or_default()
+        .iter()
+        .map(|c| c.head().as_bytes()[0])
+        .collect()
+}
+
+async fn wait_for(server: &Server, name: &str, id: SedimentreeId, want: &[u8]) {
+    let want: BTreeSet<u8> = want.iter().copied().collect();
+    let mut seed = 0x40;
+    for _ in 0..30 {
+        seed += 1;
+        if commits(server, seed, name, id).await == want {
+            return;
+        }
+        tokio::time::sleep(Duration::from_millis(500)).await;
+    }
+    panic!("{name} never held commits {want:?}");
+}
+
+#[tokio::test]
+async fn pull_peer_takes_but_never_gives() {
+    let up_dir = tempfile::tempdir().expect("tmpdir");
+    let down_dir = tempfile::tempdir().expect("tmpdir");
+    let id = SedimentreeId::new([7; 32]);
+    let (up_seed, down_seed) = ("aa".repeat(32), "bb".repeat(32));
+
+    let up = spawn_server(&up_seed, UP_NAME, up_dir.path(), &[]).await;
+    write_commit(&up, 0x10, UP_NAME, id, 1).await;
+
+    // `down` learns the document first, then restarts pointed at `up`.
+    let down = spawn_server(&down_seed, DOWN_NAME, down_dir.path(), &[]).await;
+    write_commit(&down, 0x11, DOWN_NAME, id, 2).await;
+    drop(down);
+    // Fully qualified, as a deploy might write it.
+    let peer = format!("ws://localhost.:{}", up.port);
+    let down = spawn_server(
+        &down_seed,
+        DOWN_NAME,
+        down_dir.path(),
+        &["--ws-pull-peer", &peer],
+    )
+    .await;
+
+    wait_for(&down, DOWN_NAME, id, &[1, 2]).await;
+    assert_eq!(commits(&up, 0x20, UP_NAME, id).await, [1].into());
+
+    // Live changes: `up`'s reach `down`, `down`'s stay put.
+    write_commit(&up, 0x12, UP_NAME, id, 3).await;
+    write_commit(&down, 0x13, DOWN_NAME, id, 4).await;
+    wait_for(&down, DOWN_NAME, id, &[1, 2, 3, 4]).await;
+    tokio::time::sleep(Duration::from_secs(2)).await;
+    assert_eq!(commits(&up, 0x21, UP_NAME, id).await, [1, 3].into());
+
+    // A document `down` has never seen is in its first answer: `down` pulls
+    // it before answering.
+    let other = SedimentreeId::new([8; 32]);
+    write_commit(&up, 0x14, UP_NAME, other, 5).await;
+    let client = connect(&down.url(), 0x30, DOWN_NAME).await;
+    let synced = client
+        .sync_with_all_peers(other, true, SYNC_TIMEOUT)
+        .await
+        .expect("subscribe");
+    let received: usize = synced.values().map(|(_, s, _)| s.commits_received).sum();
+    assert_eq!(received, 1, "first answer should carry up's commit");
+    wait_for(&down, DOWN_NAME, other, &[5]).await;
+}
