--- /dev/null
+++ b/subduction_core/src/handler/sync/in_flight.rs
@@ -0,0 +1,135 @@
+//! Commits and fragments whose saves are under way.
+//!
+//! A commit pushed to us is saved before it joins the in-memory tree that
+//! sync diffs read (storage is the source of truth). A sync request landing
+//! while the save runs would see the commit as missing and ask its sender for
+//! it again; with slow storage (an fsync'd redb write, an object store `PUT`)
+//! a requestor waiting for a round that moves nothing never gets one. So the
+//! responder counts what is in flight as held.
+//!
+//! An entry lasts exactly as long as the [`Saving`] token its save holds. The
+//! register keeps only a [`Weak`] to the token, so a save that fails, or
+//! whose dispatch is dropped mid-write, takes its entry with it even when
+//! the register is locked at that moment.
+
+use alloc::{
+    sync::{Arc, Weak},
+    vec::Vec,
+};
+use async_lock::Mutex;
+use sedimentree_core::{collections::Map, id::SedimentreeId, loose_commit::id::CommitId};
+
+/// An item being saved: a loose commit by its id, or a fragment by its head.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Item {
+    Commit(CommitId),
+    Fragment(CommitId),
+}
+
+type Trees = Map<SedimentreeId, Vec<(Item, Weak<()>)>>;
+
+/// The register of in-flight saves. Cheap to clone; clones share it.
+#[derive(Debug, Default, Clone)]
+pub(super) struct InFlight {
+    trees: Arc<Mutex<Trees>>,
+}
+
+impl InFlight {
+    /// Count `item` of `tree` as held until the returned token is dropped.
+    pub(super) async fn begin(&self, tree: SedimentreeId, item: Item) -> Saving {
+        let token = Arc::new(());
+        let mut trees = self.trees.lock().await;
+        let items = trees.entry(tree).or_default();
+        items.retain(|(_, saving)| saving.strong_count() > 0);
+        items.push((item, Arc::downgrade(&token)));
+        Saving {
+            token,
+            tree,
+            trees: Arc::clone(&self.trees),
+        }
+    }
+
+    /// What of `tree` is being saved now.
+    pub(super) async fn items(&self, tree: SedimentreeId) -> Vec<Item> {
+        let mut trees = self.trees.lock().await;
+        let Some(items) = trees.get_mut(&tree) else {
+            return Vec::new();
+        };
+        items.retain(|(_, saving)| saving.strong_count() > 0);
+        let held: Vec<Item> = items.iter().map(|(item, _)| *item).collect();
+        if held.is_empty() {
+            trees.remove(&tree);
+        }
+        held
+    }
+}
+
+/// Held while an item is saved; dropping it ends the item's flight.
+#[must_use = "the item is only in flight while this is held"]
+#[derive(Debug)]
+pub(super) struct Saving {
+    token: Arc<()>,
+    tree: SedimentreeId,
+    trees: Arc<Mutex<Trees>>,
+}
+
+impl Drop for Saving {
+    fn drop(&mut self) {
+        // Tidy up now if the register is free. If not, the entry is already
+        // inert (its token goes with this) and the next look at the tree
+        // prunes it.
+        let Some(mut trees) = self.trees.try_lock() else {
+            return;
+        };
+        let this = Arc::downgrade(&self.token);
+        if let Some(items) = trees.get_mut(&self.tree) {
+            items.retain(|(_, saving)| !Weak::ptr_eq(saving, &this) && saving.strong_count() > 0);
+            if items.is_empty() {
+                trees.remove(&self.tree);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{InFlight, Item};
+    use sedimentree_core::{id::SedimentreeId, loose_commit::id::CommitId};
+
+    const TREE: SedimentreeId = SedimentreeId::new([1; 32]);
+    const COMMIT: Item = Item::Commit(CommitId::new([2; 32]));
+    const FRAGMENT: Item = Item::Fragment(CommitId::new([3; 32]));
+
+    #[test]
+    fn an_item_is_held_while_its_token_is() {
+        futures::executor::block_on(async {
+            let in_flight = InFlight::default();
+            let commit = in_flight.begin(TREE, COMMIT).await;
+            let fragment = in_flight.begin(TREE, FRAGMENT).await;
+            assert_eq!(in_flight.items(TREE).await, [COMMIT, FRAGMENT]);
+            assert!(in_flight.items(SedimentreeId::new([9; 32])).await.is_empty());
+
+            drop(commit);
+            assert_eq!(in_flight.items(TREE).await, [FRAGMENT]);
+            drop(fragment);
+            assert!(in_flight.items(TREE).await.is_empty());
+            assert!(in_flight.trees.lock().await.is_empty(), "nothing left over");
+        });
+    }
+
+    /// A token dropped while the register is locked (so its `Drop` can't
+    /// tidy up) still ends the item's flight.
+    #[test]
+    fn a_token_dropped_under_contention_still_ends_the_flight() {
+        futures::executor::block_on(async {
+            let in_flight = InFlight::default();
+            let saving = in_flight.begin(TREE, COMMIT).await;
+            {
+                let _locked = in_flight.trees.lock().await;
+                drop(saving);
+            }
+            assert!(in_flight.items(TREE).await.is_empty());
+            assert!(in_flight.trees.lock().await.is_empty(), "pruned on the next look");
+        });
+    }
+}
