+    builder.http1().keep_alive(false);
+    let conn = builder.serve_connection(hyper_util::rt::TokioIo::new(tcp), service);
+
+    if let Err(e) = conn.await {
+        tracing::debug!(addr = %addr, error = %e, "HTTP connection ended");
+    }
