+/// `--static-dir`. Anything else is a 404. With `relay_probes`, also iroh's
+/// relay probes, as the iroh relay server answers them.
+async fn handle_http_get(
+    tcp: tokio::net::TcpStream,
+    addr: SocketAddr,
+    contact_card_json: Option<Arc<str>>,
+    static_dir: Option<Arc<std::path::Path>>,
+    relay_probes: bool,
