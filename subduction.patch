+//! Plain HTTP on the sync port: the keyhive contact card at
+//! `/.well-known/keyhive/contact-card.json` and files from `--static-dir`,
+//! beside the sync transports.
+
+#![allow(
+    clippy::expect_used,
+    clippy::panic,
+    clippy::unwrap_used,
+    missing_docs,
+    unreachable_pub
+)]
+
+use std::{
+    io::{Read, Write},
+    net::TcpStream,
+    process::{Child, Command, Stdio},
+    time::Duration,
+};
+
+const SERVER_STARTUP_TIMEOUT: Duration = Duration::from_secs(30);
+const CONTACT_CARD_PATH: &str = "/.well-known/keyhive/contact-card.json";
+
+struct Server {
+    child: Child,
+    port: u16,
+    _dir: tempfile::TempDir,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        drop(self.child.kill());
+        drop(self.child.wait());
+    }
+}
+
+impl Server {
+    fn url(&self, path: &str) -> String {
+        format!("http://127.0.0.1:{}{path}", self.port)
+    }
+}
+
+/// Spawn a server on an OS-assigned port and wait for its ready file.
+async fn spawn_server(auth: &str, key_seed: &str, extra: &[&str]) -> Server {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let ready_file = dir.path().join("ready");
+    let child = Command::new(env!("CARGO_BIN_EXE_subduction_cli"))
+        .arg("server")
+        .args(["--socket", "127.0.0.1:0"])
+        .args(["--key-seed", key_seed])
+        .args(["--auth", auth])
+        .arg("--data-dir")
+        .arg(dir.path().join("data"))
+        .arg("--ready-file")
+        .arg(&ready_file)
+        .args(extra)
+        .stderr(Stdio::inherit())
+        .stdout(Stdio::null())
+        .spawn()
+        .expect("failed to spawn server");
+    let mut server = Server {
+        child,
+        port: 0,
+        _dir: dir,
+    };
+
+    let deadline = tokio::time::Instant::now() + SERVER_STARTUP_TIMEOUT;
+    loop {
+        assert!(
+            tokio::time::Instant::now() <= deadline,
+            "timed out waiting for ready file at {}",
+            ready_file.display()
+        );
+        if let Ok(content) = std::fs::read_to_string(&ready_file)
+            && let Some(port) = content.lines().find_map(|l| l.strip_prefix("port="))
+        {
+            server.port = port.parse().expect("ready file port should be a u16");
+            return server;
+        }
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
+
+#[tokio::test]
+async fn keyhive_server_publishes_its_contact_card() {
+    let seed = "11".repeat(32);
+    let server = spawn_server("keyhive", &seed, &[]).await;
+
+    let resp = reqwest::get(server.url(CONTACT_CARD_PATH)).await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.headers()["content-type"], "application/json");
+    assert_eq!(resp.headers()["access-control-allow-origin"], "*");
+    let body = resp.text().await.unwrap();
+
+    let card: keyhive_core::contact_card::ContactCard =
+        serde_json::from_str(&body).expect("the body must parse as a keyhive contact card");
+    let again = serde_json::to_string(&card).unwrap();
+    assert_eq!(
+        again, body,
+        "the card round-trips through keyhive's own type"
+    );
+
+    for alias in ["/contact-card.json", "/contact-card"] {
+        let resp = reqwest::get(server.url(alias)).await.unwrap();
+        assert_eq!(resp.status(), 200, "{alias}");
+        assert_eq!(resp.headers()["content-type"], "application/json");
+        assert_eq!(resp.text().await.unwrap(), body, "{alias}");
+    }
+
+    // A query string still reaches the card; a longer path does not.
+    let resp = reqwest::get(server.url(&format!("{CONTACT_CARD_PATH}?x=1")))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    let resp = reqwest::get(server.url(&format!("{CONTACT_CARD_PATH}.bak")))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 404);
+
+    // The same key gives the same identity after a restart.
+    let issuer = |body: &str| -> serde_json::Value {
+        let value: serde_json::Value = serde_json::from_str(body).unwrap();
+        value
+            .as_object()
+            .and_then(|o| o.values().next())
+            .and_then(|op| op.get("issuer"))
+            .cloned()
+            .expect("a contact card names its issuer")
+    };
+    drop(server);
+    let restarted = spawn_server("keyhive", &seed, &[]).await;
+    let body_again = reqwest::get(restarted.url(CONTACT_CARD_PATH))
+        .await
+        .unwrap()
+        .text()
+        .await
+        .unwrap();
+    assert_eq!(issuer(&body_again), issuer(&body));
+}
