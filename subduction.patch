@@ -0,0 +1,343 @@
+//! A responder must not ask again for a commit it is already storing.
+//!
+//! When a requestor's commit arrives, the responder persists it before adding
+//! it to its in-memory tree (`insert_commit_locally`), and the sync diff is
+//! computed from that tree. A sync request that lands while the write is
+//! still running therefore sees the commit as missing and asks for it again.
+//!
+//! Clients that judge "synced" by a round that moves nothing in either
+//! direction (pushwork does) never reach that round when writes are slow —
+//! an fsync'd redb write or a remote object store PUT is enough — and report
+//! the document as unconfirmed, although nothing is wrong with it.
+//!
+//! The fix this test asks for: count commits (and fragments) whose writes are
+//! in flight as held when computing the diff.
+
+#![allow(clippy::expect_used)]
+
+use std::{collections::BTreeSet, sync::Arc, time::Duration};
+
+use future_form::Sendable;
+use futures::{FutureExt, future::BoxFuture};
+use sedimentree_core::{
+    blob::Blob,
+    collections::Set,
+    depth::CountLeadingZeroBytes,
+    fragment::Fragment,
+    id::SedimentreeId,
+    loose_commit::{LooseCommit, id::CommitId},
+};
+use subduction_core::{
+    authenticated::{Authenticated, Direction},
+    connection::test_utils::{ChannelTransport, InstantTimeout, TokioSpawn},
+    handler::sync::SyncHandler,
+    peer::id::PeerId,
+    policy::open::OpenPolicy,
+    storage::{memory::MemoryStorage, traits::Storage},
+    subduction::{Subduction, builder::SubductionBuilder},
+    timeout::call::CallTimeout,
+    transport::message::MessageTransport,
+};
+use subduction_crypto::{signer::memory::MemorySigner, verified_meta::VerifiedMeta};
+use testresult::TestResult;
+
+type Conn = MessageTransport<ChannelTransport>;
+
+/// How long each commit or fragment write takes on the slow responder.
+const WRITE_DELAY: Duration = Duration::from_millis(500);
+
+/// `MemoryStorage` whose writes of commits and fragments take [`WRITE_DELAY`].
+#[derive(Debug, Clone)]
+struct SlowWriteStorage {
+    inner: MemoryStorage,
+    delay: Duration,
+}
+
+impl SlowWriteStorage {
+    fn new(delay: Duration) -> Self {
+        Self {
+            inner: MemoryStorage::new(),
+            delay,
+        }
+    }
+}
+
+impl Storage<Sendable> for SlowWriteStorage {
+    type Error = <MemoryStorage as Storage<Sendable>>::Error;
+
+    fn save_sedimentree_id(&self, id: SedimentreeId) -> BoxFuture<'_, Result<(), Self::Error>> {
+        Storage::<Sendable>::save_sedimentree_id(&self.inner, id)
+    }
+
+    fn delete_sedimentree_id(&self, id: SedimentreeId) -> BoxFuture<'_, Result<(), Self::Error>> {
+        Storage::<Sendable>::delete_sedimentree_id(&self.inner, id)
+    }
+
+    fn load_all_sedimentree_ids(&self) -> BoxFuture<'_, Result<Set<SedimentreeId>, Self::Error>> {
+        Storage::<Sendable>::load_all_sedimentree_ids(&self.inner)
+    }
+
+    fn contains_sedimentree_id(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<bool, Self::Error>> {
+        Storage::<Sendable>::contains_sedimentree_id(&self.inner, id)
+    }
+
+    fn save_loose_commit(
+        &self,
+        id: SedimentreeId,
+        verified: VerifiedMeta<LooseCommit>,
+    ) -> BoxFuture<'_, Result<(), Self::Error>> {
+        async move {
+            tokio::time::sleep(self.delay).await;
+            Storage::<Sendable>::save_loose_commit(&self.inner, id, verified).await
+        }
+        .boxed()
+    }
+
+    fn list_commit_ids(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<Set<CommitId>, Self::Error>> {
+        Storage::<Sendable>::list_commit_ids(&self.inner, id)
+    }
+
+    fn load_loose_commits(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<Vec<VerifiedMeta<LooseCommit>>, Self::Error>> {
+        Storage::<Sendable>::load_loose_commits(&self.inner, id)
+    }
+
+    fn load_loose_commit_metas(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<Vec<LooseCommit>, Self::Error>> {
+        Storage::<Sendable>::load_loose_commit_metas(&self.inner, id)
+    }
+
+    fn load_loose_commit(
+        &self,
+        id: SedimentreeId,
+        commit_id: CommitId,
+    ) -> BoxFuture<'_, Result<Option<VerifiedMeta<LooseCommit>>, Self::Error>> {
+        Storage::<Sendable>::load_loose_commit(&self.inner, id, commit_id)
+    }
+
+    fn delete_loose_commit(
+        &self,
+        id: SedimentreeId,
+        commit_id: CommitId,
+    ) -> BoxFuture<'_, Result<(), Self::Error>> {
+        Storage::<Sendable>::delete_loose_commit(&self.inner, id, commit_id)
+    }
+
+    fn delete_loose_commits(&self, id: SedimentreeId) -> BoxFuture<'_, Result<(), Self::Error>> {
+        Storage::<Sendable>::delete_loose_commits(&self.inner, id)
+    }
+
+    fn save_fragment(
+        &self,
+        id: SedimentreeId,
+        verified: VerifiedMeta<Fragment>,
+    ) -> BoxFuture<'_, Result<(), Self::Error>> {
+        async move {
+            tokio::time::sleep(self.delay).await;
+            Storage::<Sendable>::save_fragment(&self.inner, id, verified).await
+        }
+        .boxed()
+    }
+
+    fn load_fragment(
+        &self,
+        id: SedimentreeId,
+        fragment_head: CommitId,
+    ) -> BoxFuture<'_, Result<Option<VerifiedMeta<Fragment>>, Self::Error>> {
+        Storage::<Sendable>::load_fragment(&self.inner, id, fragment_head)
+    }
+
+    fn list_fragment_ids(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<Set<CommitId>, Self::Error>> {
+        Storage::<Sendable>::list_fragment_ids(&self.inner, id)
+    }
+
+    fn load_fragments(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<Vec<VerifiedMeta<Fragment>>, Self::Error>> {
+        Storage::<Sendable>::load_fragments(&self.inner, id)
+    }
+
+    fn load_fragment_metas(
+        &self,
+        id: SedimentreeId,
+    ) -> BoxFuture<'_, Result<Vec<Fragment>, Self::Error>> {
+        Storage::<Sendable>::load_fragment_metas(&self.inner, id)
+    }
+
+    fn delete_fragment(
+        &self,
+        id: SedimentreeId,
+        fragment_head: CommitId,
+    ) -> BoxFuture<'_, Result<(), Self::Error>> {
+        Storage::<Sendable>::delete_fragment(&self.inner, id, fragment_head)
+    }
+
+    fn delete_fragments(&self, id: SedimentreeId) -> BoxFuture<'_, Result<(), Self::Error>> {
+        Storage::<Sendable>::delete_fragments(&self.inner, id)
+    }
+
+    fn save_batch(
+        &self,
+        id: SedimentreeId,
+        commits: Vec<VerifiedMeta<LooseCommit>>,
+        fragments: Vec<VerifiedMeta<Fragment>>,
+    ) -> BoxFuture<'_, Result<usize, Self::Error>> {
+        async move {
+            tokio::time::sleep(self.delay).await;
+            Storage::<Sendable>::save_batch(&self.inner, id, commits, fragments).await
+        }
+        .boxed()
+    }
+}
+
+type SlowSyncHandler =
+    SyncHandler<Sendable, SlowWriteStorage, Conn, OpenPolicy, CountLeadingZeroBytes, TokioSpawn>;
+
+type SlowSubduction = Arc<
+    Subduction<
+        'static,
+        Sendable,
+        SlowWriteStorage,
+        Conn,
+        SlowSyncHandler,
+        OpenPolicy,
+        MemorySigner,
+        InstantTimeout,
+        TokioSpawn,
+    >,
+>;
+
+fn make_node(signer: MemorySigner, storage: SlowWriteStorage) -> SlowSubduction {
+    let (sd, _handler, listener, manager) = SubductionBuilder::new()
+        .signer(signer)
+        .storage(storage, Arc::new(OpenPolicy))
+        .spawner(TokioSpawn)
+        .timer(InstantTimeout)
+        .build::<Sendable, Conn>();
+
+    tokio::spawn(listener);
+    tokio::spawn(manager);
+    sd
+}
+
+async fn connect_pair(
+    a: &SlowSubduction,
+    a_signer: &MemorySigner,
+    b: &SlowSubduction,
+    b_signer: &MemorySigner,
+) -> TestResult {
+    let (transport_a, transport_b) = ChannelTransport::pair();
+    let peer_a = PeerId::from(a_signer.verifying_key());
+    let peer_b = PeerId::from(b_signer.verifying_key());
+    let auth_a: Authenticated<Conn, Sendable> = Authenticated::new_for_test(
+        MessageTransport::new(transport_a),
+        peer_b,
+        Direction::Dialed,
+    );
+    let auth_b: Authenticated<Conn, Sendable> = Authenticated::new_for_test(
+        MessageTransport::new(transport_b),
+        peer_a,
+        Direction::Accepted,
+    );
+    a.add_connection(auth_a).await?;
+    b.add_connection(auth_b).await?;
+    Ok(())
+}
+
+/// Alice syncs a new commit to Bob, whose storage writes are slow, then
+/// syncs again straight away. Bob already holds the commit — it arrived and
+/// its write is under way — so the second round must not send it again.
+#[tokio::test]
+async fn commit_being_stored_is_not_requested_again() -> TestResult {
+    let alice_signer = MemorySigner::from_bytes(&[70u8; 32]);
+    let bob_signer = MemorySigner::from_bytes(&[71u8; 32]);
+
+    let alice = make_node(alice_signer.clone(), SlowWriteStorage::new(Duration::ZERO));
+    let bob = make_node(bob_signer.clone(), SlowWriteStorage::new(WRITE_DELAY));
+
+    let sed_id = SedimentreeId::new([0x7A; 32]);
+    alice
+        .add_commit(
+            sed_id,
+            CommitId::new([0xA7; 32]),
+            BTreeSet::new(),
+            Blob::new(vec![7; 64]),
+        )
+        .await?;
+
+    connect_pair(&alice, &alice_signer, &bob, &bob_signer).await?;
+    let bob_peer = PeerId::from(bob_signer.verifying_key());
+
+    let (synced, first, _) = alice
+        .sync_with_peer(&bob_peer, sed_id, false, CallTimeout::TimeoutMillis(5_000))
+        .await?;
+    assert!(synced, "the first round should reach Bob");
+    assert_eq!(first.commits_sent, 1, "Bob asks for the commit once");
+
+    // Give the commit time to arrive at Bob, but not for his write to finish.
+    tokio::time::sleep(WRITE_DELAY / 5).await;
+
+    let (synced, second, _) = alice
+        .sync_with_peer(&bob_peer, sed_id, false, CallTimeout::TimeoutMillis(5_000))
+        .await?;
+    assert!(synced, "the second round should reach Bob");
+    assert_eq!(
+        second.commits_sent, 0,
+        "Bob is already storing the commit and must not ask for it again"
+    );
+
+    Ok(())
+}
+
+/// Control: once Bob's write has finished, a further round moves nothing.
+/// This passes today; it pins that the failure above is about the write
+/// being in flight, not about the commit going missing.
+#[tokio::test]
+async fn commit_is_not_requested_after_its_write_finishes() -> TestResult {
+    let alice_signer = MemorySigner::from_bytes(&[72u8; 32]);
+    let bob_signer = MemorySigner::from_bytes(&[73u8; 32]);
+
+    let alice = make_node(alice_signer.clone(), SlowWriteStorage::new(Duration::ZERO));
+    let bob = make_node(bob_signer.clone(), SlowWriteStorage::new(WRITE_DELAY));
+
+    let sed_id = SedimentreeId::new([0x7B; 32]);
+    alice
+        .add_commit(
+            sed_id,
+            CommitId::new([0xB7; 32]),
+            BTreeSet::new(),
+            Blob::new(vec![8; 64]),
+        )
+        .await?;
+
+    connect_pair(&alice, &alice_signer, &bob, &bob_signer).await?;
+    let bob_peer = PeerId::from(bob_signer.verifying_key());
+
+    let (_, first, _) = alice
+        .sync_with_peer(&bob_peer, sed_id, false, CallTimeout::TimeoutMillis(5_000))
+        .await?;
+    assert_eq!(first.commits_sent, 1);
+
+    tokio::time::sleep(WRITE_DELAY * 2).await;
+
+    let (_, second, _) = alice
+        .sync_with_peer(&bob_peer, sed_id, false, CallTimeout::TimeoutMillis(5_000))
+        .await?;
+    assert_eq!(second.commits_sent, 0, "nothing left to send");
+
+    Ok(())
+}
